{
  "name": "@signalk/open-meteo-provider",
  "version": "1.3.0",
  "description": "Open-Meteo weather provider plugin for Signal K Server",
  "main": "plugin/index.js",
  "signalk": {
    "displayName": "OpenMeteo Weather Provider",
    "appIcon": "./app-icon.svg"
  },
  "scripts": {
    "build": "tsc",
    "build-declaration": "tsc --declaration --allowJs false",
    "test": "vitest run",
    "watch": "npm run build -- -w",
    "start": "npm run watch",
    "prepublishOnly": "tsc",
    "prettier": "prettier -w src/",
    "lint": "eslint -c .eslintrc.js --ext .ts --ext .js --fix src/",
    "format": "npm run prettier && npm run lint"
  },
  "license": "Apache-2.0",
  "keywords": [
    "signalk",
    "signalk-node-server-plugin",
    "signalk-category-weather"
  ],
  "author": {
    "name": "AdrianP"
  },
  "dependencies": {
    "@signalk/server-api": "^2.28.0",
    "geolib": "^3.3.4",
    "tslib": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SignalK/openmeteo-provider-plugin"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@types/baconjs": "^0.7.34",
    "@types/express": "^4.17.17",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "prettier": "^2.8.4",
    "typescript": "^6.0.3",
    "vitest": "^2.0.0"
  }
}
